<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " – ChatHub" : "ChatHub")</title>
    <link rel="icon" type="image/png" href="~/Images/logo.png" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

        /* ── DARK TOKENS ── */
        :root, [data-theme="dark"] {
            --bg-base:#09090b; --bg-1:#0f0f12; --bg-2:#18181d; --bg-3:#222228; --bg-4:#2c2c35;
            --border:rgba(255,255,255,0.07); --border-2:rgba(255,255,255,0.12); --border-3:rgba(255,255,255,0.20);
            --accent:#7c6aff; --accent-2:#a594ff; --accent-dim:rgba(124,106,255,0.10);
            --text-1:#f4f3f8; --text-2:#9896a8; --text-3:#5a5868;
            --green:#22c55e; --yellow:#f59e0b; --red:#ef4444;
            --radius:12px; --header-h:64px;
            --font:'DM Sans',sans-serif; --font-display:'Syne',sans-serif; --font-mono:'JetBrains Mono',monospace;
            --header-bg:rgba(9,9,11,0.6); --header-border:rgba(255,255,255,0.06);
            --footer-bg:rgba(9,9,11,0.55);
            --nav-bg:rgba(255,255,255,0.03); --nav-border:rgba(255,255,255,0.06);
            --toggle-bg:rgba(255,255,255,0.06); --toggle-border:rgba(255,255,255,0.10);
            --toggle-icon:#9896a8;
        }

        /* ── LIGHT TOKENS ── */
        [data-theme="light"] {
            --bg-base:#f4f3f8; --bg-1:#eeedf5; --bg-2:#e8e7f0; --bg-3:#dddce8; --bg-4:#d0cfe0;
            --border:rgba(0,0,0,0.06); --border-2:rgba(0,0,0,0.10); --border-3:rgba(0,0,0,0.18);
            --accent:#7c6aff; --accent-2:#5b4ed4; --accent-dim:rgba(124,106,255,0.10);
            --text-1:#111018; --text-2:#3d3b52; --text-3:#7a7890;
            --green:#16a34a; --yellow:#d97706; --red:#dc2626;
            --radius:12px; --header-h:64px;
            --font:'DM Sans',sans-serif; --font-display:'Syne',sans-serif; --font-mono:'JetBrains Mono',monospace;
            --header-bg:rgba(244,243,248,0.90); --header-border:rgba(0,0,0,0.07);
            --footer-bg:rgba(244,243,248,0.90);
            --nav-bg:rgba(0,0,0,0.04); --nav-border:rgba(0,0,0,0.08);
            --toggle-bg:rgba(0,0,0,0.05); --toggle-border:rgba(0,0,0,0.10);
            --toggle-icon:#3d3b52;
        }

        /* ── BASE ── */
        html, body {
            font-family:var(--font); background:var(--bg-base); color:var(--text-1);
            min-height:100vh; transition:background .3s,color .3s;
        }
        body { display:flex; flex-direction:column; position:relative; }

        body::before {
            content:''; position:fixed; inset:0; pointer-events:none; z-index:0;
            background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
            opacity:.022;
        }
        [data-theme="light"] body::before { display:none; }

        /* ── CANVAS ── */
        #global-canvas {
            position:fixed; inset:0; width:100%; height:100%;
            pointer-events:none; z-index:0; transition:opacity .3s;
        }
        [data-theme="light"] #global-canvas { opacity:.3; }

        /* ── HEADER ── */
        .site-header {
            height:var(--header-h); display:flex; align-items:center;
            justify-content:space-between; padding:0 2rem;
            position:sticky; top:0; z-index:100; flex-shrink:0;
            background:var(--header-bg); backdrop-filter:blur(20px);
            -webkit-backdrop-filter:blur(20px);
            border-bottom:1px solid var(--header-border);
            box-shadow:0 1px 0 rgba(255,255,255,.04),0 4px 24px rgba(0,0,0,.08);
            transition:background .3s,border-color .3s,box-shadow .3s;
        }
        [data-theme="light"] .site-header {
            box-shadow:0 1px 0 rgba(0,0,0,.06),0 4px 16px rgba(0,0,0,.06);
        }

        .header-brand {
            font-family:var(--font-display); font-size:1.15rem; font-weight:700;
            color:var(--text-1); text-decoration:none; letter-spacing:-.4px;
            display:flex; align-items:center; gap:8px; flex-shrink:0;
        }
        .brand-icon {
            width:30px; height:30px; border-radius:8px;
            background:linear-gradient(135deg,var(--accent),#5b4ed4);
            display:flex; align-items:center; justify-content:center;
            font-size:.85rem; box-shadow:0 0 14px rgba(124,106,255,.35); flex-shrink:0;
        }
        .brand-name {
            background:linear-gradient(135deg,var(--accent-2),var(--accent));
            -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
        }

        /* ── NAV ── */
        .header-nav {
            display:flex; align-items:center; gap:2px;
            background:var(--nav-bg); border:1px solid var(--nav-border);
            border-radius:10px; padding:4px; transition:background .3s,border-color .3s;
        }
        .header-nav a {
            padding:6px 14px; border-radius:7px; color:var(--text-2);
            text-decoration:none; font-size:.855rem; font-weight:500;
            transition:color .15s,background .15s; white-space:nowrap;
        }
        .header-nav a:hover { color:var(--text-1); background:rgba(124,106,255,.08); }
        .header-nav a.active { color:var(--text-1); background:rgba(124,106,255,.10); }

        .nav-divider { width:1px; height:18px; background:var(--border-2); margin:0 2px; }

        .btn-create {
            background:var(--accent) !important; color:#fff !important;
            border-radius:7px !important; box-shadow:0 0 14px rgba(124,106,255,.3);
            position:relative; overflow:hidden;
        }
        .btn-create::before {
            content:''; position:absolute; inset:0;
            background:linear-gradient(135deg,rgba(255,255,255,.12) 0%,transparent 60%);
        }
        .btn-create:hover { opacity:.88 !important; }

        .btn-nav-login {
            padding:7px 16px !important; border:1px solid var(--border-2) !important;
            border-radius:8px !important; color:var(--text-2) !important;
            background:transparent !important; transition:all .15s !important;
        }
        .btn-nav-login:hover {
            border-color:var(--border-3) !important; color:var(--text-1) !important;
            background:var(--accent-dim) !important;
        }
        .btn-nav-register {
            padding:7px 16px !important; border-radius:8px !important;
            background:var(--accent) !important; color:#fff !important;
            box-shadow:0 0 14px rgba(124,106,255,.3) !important;
        }
        .btn-nav-register:hover { opacity:.88 !important; }

        /* ── HEADER RIGHT ── */
        .header-right { display:flex; align-items:center; gap:.6rem; }

        .btn-admin-pill {
            display:flex; align-items:center; gap:5px; padding:5px 12px;
            background:var(--accent-dim); border:1px solid rgba(124,106,255,.25);
            border-radius:100px; color:var(--accent-2);
            font-size:.78rem; font-weight:600; text-decoration:none; transition:all .15s;
        }
        .btn-admin-pill:hover { background:rgba(124,106,255,.2); border-color:rgba(124,106,255,.4); }

        .btn-icon-pill {
            position:relative; display:flex; align-items:center; justify-content:center;
            width:32px; height:32px; background:var(--toggle-bg); border:1px solid var(--toggle-border);
            border-radius:50%; color:var(--text-2); text-decoration:none;
            transition:all .15s; flex-shrink:0;
        }
        .btn-icon-pill:hover { color:var(--text-1); border-color:var(--border-3); background:var(--accent-dim); }

        .notif-badge {
            display:none; position:absolute; top:-3px; right:-3px;
            min-width:16px; height:16px; background:var(--red); color:#fff;
            border-radius:100px; font-size:.6rem; font-weight:700;
            align-items:center; justify-content:center; padding:0 3px;
            border:2px solid var(--bg-base); line-height:1;
        }
        .notif-badge.visible { display:flex; }

        /* ── THEME TOGGLE ── */
        .theme-toggle {
            display:flex; align-items:center; justify-content:center;
            width:32px; height:32px; background:var(--toggle-bg);
            border:1px solid var(--toggle-border); border-radius:50%;
            color:var(--toggle-icon); cursor:pointer; flex-shrink:0; padding:0;
            transition:color .2s,border-color .2s,background .2s,transform .2s;
        }
        .theme-toggle:hover {
            color:var(--accent); border-color:rgba(124,106,255,.35);
            background:var(--accent-dim); transform:rotate(15deg);
        }
        .theme-toggle svg { pointer-events:none; }
        .icon-sun { display:none; }
        .icon-moon { display:block; }
        [data-theme="light"] .icon-sun { display:block; }
        [data-theme="light"] .icon-moon { display:none; }

        /* ── USER PILL ── */
        .user-pill {
            display:flex; align-items:center; gap:8px; padding:5px 12px 5px 5px;
            background:var(--toggle-bg); border:1px solid var(--toggle-border);
            border-radius:100px; transition:background .3s,border-color .3s;
        }
        .user-avatar-mini {
            width:26px; height:26px; border-radius:50%;
            background:linear-gradient(135deg,var(--accent),#5b4ed4);
            display:flex; align-items:center; justify-content:center;
            font-size:.65rem; font-weight:700; color:#fff; flex-shrink:0;
            font-family:var(--font-display); overflow:hidden;
        }
        .user-avatar-mini img { width:100%; height:100%; object-fit:cover; }
        .user-pill-name {
            font-size:.82rem; color:var(--text-2); font-weight:500;
            max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
        }

        /* ── LOGOUT ── */
        .logout-btn {
            display:flex; align-items:center; gap:6px; padding:7px 14px;
            background:transparent; border:1px solid var(--border); border-radius:8px;
            color:var(--text-3); font-family:var(--font); font-size:.82rem;
            cursor:pointer; transition:all .15s;
        }
        .logout-btn:hover { border-color:rgba(239,68,68,.4); color:var(--red); background:rgba(239,68,68,.07); }
        [data-theme="light"] .logout-btn:hover { border-color:rgba(220,38,38,.35); background:rgba(220,38,38,.06); }

        /* ── HAMBURGER ── */
        .hamburger {
            display:none; flex-direction:column; justify-content:center; gap:5px;
            width:36px; height:36px; background:transparent; border:none;
            cursor:pointer; padding:4px; border-radius:6px; transition:background .15s;
        }
        .hamburger:hover { background:var(--toggle-bg); }
        .hamburger span { display:block; width:100%; height:2px; background:var(--text-2); border-radius:2px; transition:all .25s; }

        /* ── MAIN ── */
        .site-main { flex:1; padding:2rem; position:relative; z-index:1; }

        /* ── FOOTER ── */
        .site-footer {
            position:relative; z-index:1; flex-shrink:0;
            background:var(--footer-bg); backdrop-filter:blur(12px);
            -webkit-backdrop-filter:blur(12px);
            border-top:1px solid var(--header-border);
            transition:background .3s,border-color .3s;
        }
        .footer-inner {
            max-width:1200px; margin:0 auto; padding:1.2rem 2rem;
            display:flex; align-items:center; justify-content:space-between;
            flex-wrap:wrap; gap:.75rem;
        }
        .footer-brand { display:flex; align-items:center; gap:8px; text-decoration:none; }
        .footer-logo-dot {
            width:22px; height:22px; border-radius:6px;
            background:linear-gradient(135deg,var(--accent),#5b4ed4);
            display:flex; align-items:center; justify-content:center;
            font-size:.65rem; box-shadow:0 0 10px rgba(124,106,255,.25);
        }
        .footer-brand-name {
            font-family:var(--font-display); font-size:.875rem; font-weight:600;
            background:linear-gradient(135deg,var(--accent-2),var(--accent));
            -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
        }
        .footer-copy { font-size:.77rem; color:var(--text-3); }
        .footer-links { display:flex; align-items:center; gap:1.25rem; }
        .footer-links a { font-size:.77rem; color:var(--text-3); text-decoration:none; transition:color .15s; }
        .footer-links a:hover { color:var(--text-2); }
        .footer-badge {
            display:flex; align-items:center; gap:5px; font-size:.72rem; color:var(--text-3);
            padding:4px 10px; background:var(--toggle-bg); border:1px solid var(--toggle-border);
            border-radius:100px;
        }
        .footer-badge-dot {
            width:5px; height:5px; border-radius:50%;
            background:var(--green); box-shadow:0 0 5px var(--green);
            animation:pulse 2s ease-in-out infinite;
        }
        @@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }

        /* ── ALERTS ── */
        .alert {
            padding:.75rem 1rem; border-radius:var(--radius); margin-bottom:1rem;
            font-size:.875rem; display:flex; align-items:center; gap:.5rem;
        }
        .alert-success { background:rgba(34,197,94,.08); border:1px solid rgba(34,197,94,.2); color:var(--green); }
        .alert-error   { background:rgba(239,68,68,.08);  border:1px solid rgba(239,68,68,.2);  color:var(--red); }
        [data-theme="light"] .alert-success { background:rgba(22,163,74,.08); border-color:rgba(22,163,74,.22); }
        [data-theme="light"] .alert-error   { background:rgba(220,38,38,.07); border-color:rgba(220,38,38,.20); }

        /* ── UTILITIES ── */
        .status-dot { width:10px; height:10px; border-radius:50%; display:inline-block; }
        .status-dot.online  { background:var(--green); box-shadow:0 0 6px var(--green); }
        .status-dot.offline { background:var(--text-3); }
        .voice-player { max-width:260px; height:36px; }
        .voice-bubble { background:var(--accent-dim); border-radius:12px; padding:8px 12px; }

        /* ── RESPONSIVE ── */
        @@media (max-width:768px) {
            .site-header { padding:0 1rem; height:56px; }
            .header-brand { font-size:1rem; }
            .header-nav {
                display:none; flex-direction:column; position:fixed;
                top:56px; left:0; right:0; background:var(--header-bg);
                backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px);
                border-bottom:1px solid var(--header-border);
                padding:1rem; gap:4px; z-index:99;
            }
            .header-nav.open { display:flex; }
            .header-nav.open a { padding:10px 14px; border-radius:8px; font-size:.9rem; }
            .nav-divider { display:none; }
            .hamburger { display:flex; }
            .user-pill-name { display:none; }
            .btn-admin-pill span { display:none; }
            .logout-btn span { display:none; }
            .logout-btn { padding:7px 10px; }
            .brand-name { display:none; }
            .site-main { padding:1rem; }
            .footer-inner { padding:1rem; flex-direction:column; align-items:flex-start; gap:.6rem; }
            .footer-links { gap:1rem; }
            .footer-badge { align-self:flex-start; }
        }
        @@media (max-width:480px) {
            .site-header { padding:0 .75rem; }
            .site-main { padding:.75rem; }
        }
        @@media (min-width:769px) {
            .hamburger { display:none !important; }
            .header-nav { display:flex !important; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <canvas id="global-canvas" aria-hidden="true"></canvas>

    <!-- HEADER -->
    <header class="site-header" role="banner">

        <a class="header-brand" href="/">
            <div class="brand-icon" aria-hidden="true">💬</div>
            <span class="brand-name">ChatHub</span>
        </a>

        <button class="hamburger" id="js-hamburger"
                aria-label="Toggle navigation" aria-expanded="false" aria-controls="js-nav">
            <span></span><span></span><span></span>
        </button>

        <nav class="header-nav" id="js-nav" role="navigation" aria-label="Main">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <a href="/Rooms/Index">Rooms</a>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Users/Index">People</a>
                }
                <div class="nav-divider" aria-hidden="true"></div>
                <a href="/Rooms/Create" class="btn-create">＋ New Room</a>
            }
            else
            {
                <a href="/Auth/Login" class="btn-nav-login">Login</a>
                <a href="/Auth/Register" class="btn-nav-register">Get Started</a>
            }
        </nav>

        <div class="header-right" role="complementary">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                               ?? User.Identity!.Name ?? "U";
                var initials = string.Join("",
                    displayName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries)
                               .Select(w => char.ToUpper(w[0])).Take(2));
                var avatar = User.FindFirst("profilePicture")?.Value;

                if (User.IsInRole("Admin"))
                {
                    <a href="/Admin" class="btn-admin-pill" title="Admin Dashboard">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                            <path d="M2 17l10 5 10-5"/>
                            <path d="M2 12l10 5 10-5"/>
                        </svg>
                        <span>Admin</span>
                    </a>
                }

                <a href="/Notifications" class="btn-icon-pill" id="js-notif-btn"
                   title="Notifications" aria-label="Notifications">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span class="notif-badge" id="js-notif-badge" aria-live="polite"></span>
                </a>

                <a href="/Profile" class="btn-icon-pill" title="My Profile" aria-label="My Profile">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </a>

                <div class="user-pill">
                    <div class="user-avatar-mini">
                        @if (!string.IsNullOrEmpty(avatar))
                        {
                            <img src="@avatar" alt="@displayName" />
                        }
                        else { @initials }
                    </div>
                    <span class="user-pill-name">@displayName</span>
                </div>

                <form method="post" action="/Auth/Logout" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-btn" aria-label="Logout">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                        <span>Logout</span>
                    </button>
                </form>
            }

            <button class="theme-toggle" id="js-theme-toggle"
                    aria-label="Toggle light/dark mode" title="Toggle theme">
                <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
                <svg class="icon-sun" width="14" height="14" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="5"/>
                    <line x1="12" y1="1"  x2="12" y2="3"/>
                    <line x1="12" y1="21" x2="12" y2="23"/>
                    <line x1="4.22"  y1="4.22"  x2="5.64"  y2="5.64"/>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                    <line x1="1"  y1="12" x2="3"  y2="12"/>
                    <line x1="21" y1="12" x2="23" y2="12"/>
                    <line x1="4.22"  y1="19.78" x2="5.64"  y2="18.36"/>
                    <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"/>
                </svg>
            </button>
        </div>
    </header>

    <!-- MAIN -->
    <main class="site-main" id="main-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="alert">✓ @TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error" role="alert">⚠ @TempData["ErrorMessage"]</div>
        }
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="site-footer" role="contentinfo">
        <div class="footer-inner">
            <a class="footer-brand" href="/">
                <div class="footer-logo-dot" aria-hidden="true">💬</div>
                <span class="footer-brand-name">ChatHub</span>
            </a>
            <span class="footer-copy">© @DateTime.Now.Year ChatHub. All rights reserved.</span>
            <nav class="footer-links" aria-label="Footer">
                <a href="/">Home</a>
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <a href="/Rooms/Index">Rooms</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Users/Index">People</a>
                    }
                }
            </nav>
            <div class="footer-badge">
                <span class="footer-badge-dot" aria-hidden="true"></span>
                All systems online
            </div>
        </div>
    </footer>

    <!-- SCRIPTS — الترتيب مهم جداً -->
    <script src="~/js/token-manager.js"></script>
    <script src="~/js/request-interceptor.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    @if (User?.Identity?.IsAuthenticated ?? false)
    {
        <script>
            (function () {
                // لو الصفحة (Room/Private) فيها connection خاص — وقف فوراً
                if (window.__notifHubReady) return;

                var attempts = 0;
                var MAX_ATTEMPTS = 20;   // 20 × 150ms = 3 ثواني
                var INTERVAL     = 150;

                function tryStart() {
                    attempts++;

                    // لو الصفحة عملت connection في الأثناء — وقف
                    if (window.__notifHubReady || window.ChatConfig?.connection) return;

                    // لسه في محاولات — استنى
                    if (attempts < MAX_ATTEMPTS) {
                        setTimeout(tryStart, INTERVAL);
                        return;
                    }

                    // انتهت المحاولات ومفيش connection — ابدأ واحد للـ notifications
                    var conn = new signalR.HubConnectionBuilder()
                        .withUrl('/chathub', {
                            accessTokenFactory: function () { return TokenManager.getToken() || ''; }
                        })
                        .withAutomaticReconnect()
                        .build();

                    conn.start()
                        .then(function () {
                            // تأكد تاني إن مفيش connection اتعمل في الأثناء
                            if (window.__notifHubReady || window.ChatConfig?.connection) {
                                conn.stop();
                                return;
                            }
                            window.ChatConfig = { connection: conn };
                        })
                        .catch(function (err) { console.warn('[notif-hub]', err); });
                }

                setTimeout(tryStart, INTERVAL);
            })();
        </script>
    }

    <script src="~/js/notifications.js"></script>

    <script>
        (function () {
            'use strict';

            /* ── 1. Theme ───────────────────────────────── */
            var html   = document.documentElement;
            var toggle = document.getElementById('js-theme-toggle');
            var saved  = localStorage.getItem('chathub-theme') || 'dark';
            html.setAttribute('data-theme', saved);

            if (toggle) {
                toggle.addEventListener('click', function () {
                    var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                    html.setAttribute('data-theme', next);
                    localStorage.setItem('chathub-theme', next);
                });
            }

            /* ── 2. Particle canvas ─────────────────────── */
            var canvas = document.getElementById('global-canvas');
            if (canvas) {
                var ctx = canvas.getContext('2d');
                var W, H, animId;
                var COUNT = 130, CONNECT = 110;
                var mouse = { x: -9999, y: -9999 };
                var pts   = [];

                function resize() {
                    W = canvas.width  = window.innerWidth;
                    H = canvas.height = window.innerHeight;
                }

                function mkP() {
                    return {
                        x:  Math.random() * W,
                        y:  Math.random() * H,
                        vx: (Math.random() - .5) * .28,
                        vy: (Math.random() - .5) * .28,
                        r:  Math.random() * 1.4 + .4,
                        o:  Math.random() * .45 + .1
                    };
                }

                function pColor() {
                    return html.getAttribute('data-theme') === 'light'
                        ? 'rgba(91,78,212,' : 'rgba(165,148,255,';
                }
                function lColor() {
                    return html.getAttribute('data-theme') === 'light'
                        ? 'rgba(91,78,212,' : 'rgba(124,106,255,';
                }

                function draw() {
                    ctx.clearRect(0, 0, W, H);
                    var i, j, p, a, b, dx, dy, d, f;
                    var pc = pColor(), lc = lColor();

                    for (i = 0; i < pts.length; i++) {
                        p = pts[i];
                        dx = p.x - mouse.x; dy = p.y - mouse.y;
                        d  = Math.sqrt(dx*dx + dy*dy);
                        if (d < 160 && d > 0) {
                            f = (160 - d) / 160;
                            p.x += dx/d * f * .9;
                            p.y += dy/d * f * .9;
                        }
                        p.x += p.vx; p.y += p.vy;
                        if (p.x < -10)   p.x = W + 10;
                        if (p.x > W + 10) p.x = -10;
                        if (p.y < -10)   p.y = H + 10;
                        if (p.y > H + 10) p.y = -10;
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
                        ctx.fillStyle = pc + p.o + ')';
                        ctx.fill();
                    }

                    for (i = 0; i < pts.length; i++) {
                        for (j = i+1; j < pts.length; j++) {
                            a = pts[i]; b = pts[j];
                            dx = a.x-b.x; dy = a.y-b.y;
                            d  = Math.sqrt(dx*dx + dy*dy);
                            if (d < CONNECT) {
                                ctx.beginPath();
                                ctx.moveTo(a.x, a.y);
                                ctx.lineTo(b.x, b.y);
                                ctx.strokeStyle = lc + ((1 - d/CONNECT) * .18) + ')';
                                ctx.lineWidth   = .6;
                                ctx.stroke();
                            }
                        }
                    }
                    animId = requestAnimationFrame(draw);
                }

                resize();
                for (var k = 0; k < COUNT; k++) pts.push(mkP());
                window.addEventListener('resize', resize);
                window.addEventListener('mousemove',  function(e){ mouse.x=e.clientX; mouse.y=e.clientY; });
                window.addEventListener('mouseleave', function(){ mouse.x=-9999; mouse.y=-9999; });
                draw();
            }

            /* ── 3. Mobile menu ─────────────────────────── */
            var hamburger = document.getElementById('js-hamburger');
            var nav       = document.getElementById('js-nav');
            if (hamburger && nav) {
                hamburger.addEventListener('click', function () {
                    var open = nav.classList.toggle('open');
                    hamburger.setAttribute('aria-expanded', String(open));
                });
                document.addEventListener('click', function (e) {
                    if (!nav.contains(e.target) && !hamburger.contains(e.target)) {
                        nav.classList.remove('open');
                        hamburger.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            /* ── 4. Active nav highlight ────────────────── */
            var path  = window.location.pathname.toLowerCase();
            var links = document.querySelectorAll('.header-nav a');
            for (var n = 0; n < links.length; n++) {
                var href = (links[n].getAttribute('href') || '').toLowerCase();
                if (href && href !== '/' && path.startsWith(href)) {
                    links[n].classList.add('active');
                }
            }

        }());
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
