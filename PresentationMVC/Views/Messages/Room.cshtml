@model IEnumerable<Application.DTOs.MessageDTOs.MessageDto>
@using System.Security.Claims

@{
    ViewBag.Title = $"Chat - {ViewBag.RoomName}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .chat-container {
            display: flex;
            flex-direction: column;
            height: calc(100vh - 200px);
            max-width: 1000px;
            margin: 0 auto;
            background: var(--bg-1);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
        }

        .chat-header {
            background: linear-gradient(to bottom, var(--bg-2), var(--bg-1));
            border-bottom: 1px solid var(--border);
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .chat-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-1);
        }

        .chat-title-text::before {
            content: '#';
            color: var(--accent);
            margin-right: 0.25rem;
        }

        .chat-members {
            color: var(--text-2);
            font-size: 0.85rem;
        }

        .messages-container {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .message {
            display: flex;
            gap: 0.75rem;
        }

        .message.own { flex-direction: row-reverse; }

        .message-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--accent-dim);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .message-content { max-width: 60%; }

        .message-bubble {
            background: var(--bg-2);
            border: 1px solid var(--border);
            padding: 0.75rem 1rem;
            border-radius: 12px;
        }

        .message.own .message-bubble {
            background: var(--accent);
            color: white;
        }

        .input-container {
            display: flex;
            gap: 0.75rem;
            padding: 1rem;
            border-top: 1px solid var(--border);
            background: var(--bg-2);
            align-items: center;
        }

        .message-input {
            flex: 1;
            padding: 0.75rem;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--bg-1);
            color: var(--text-1);
            font-family: var(--font);
            outline: none;
        }

        .message-input:focus { border-color: var(--accent); }

        .send-btn {
            padding: 0.75rem 1.2rem;
            background: var(--accent);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        #recordBtn { min-width: 44px; min-height: 44px; }

        #recordingBadge {
            align-self: center;
            padding: 4px 10px;
            background: rgba(239,68,68,0.15);
            border: 1px solid rgba(239,68,68,0.3);
            border-radius: 100px;
            color: #ef4444;
            font-size: 0.78rem;
        }

        @@media (max-width: 768px) {
            .chat-container {
                height: calc(100dvh - 130px);
                margin: 0;
                border-radius: 0;
                border-left: none;
                border-right: none;
                max-width: 100%;
            }
            .chat-header { padding: 0.75rem 1rem; }
            .messages-container { padding: 0.75rem; gap: 0.6rem; }
            .message-content { max-width: 80%; }
            .input-container { padding: 0.6rem; gap: 0.5rem; }
            .message-input { padding: 0.6rem 0.75rem; font-size: 1rem; }
            .send-btn { padding: 0.6rem 0.9rem; font-size: 0.9rem; }
            #recordBtn { min-width: 40px; min-height: 40px; }
            #recordingBadge { font-size: 0.72rem; padding: 3px 8px; }
        }

        @@media (max-width: 480px) {
            .chat-container { height: calc(100dvh - 120px); }
            .message-avatar { width: 28px; height: 28px; font-size: 0.7rem; }
            .message-content { max-width: 85%; }
            .send-btn { padding: 0.5rem 0.8rem; }
        }

        @@media (min-width: 1280px) {
            .chat-container { max-width: 1100px; }
        }
    </style>
}

<div class="chat-container">
    <div class="chat-header">
        <div class="chat-title">
            <div class="chat-title-text">@ViewBag.RoomName</div>
        </div>
        <div class="chat-members">
            <span id="members-text">Loading...</span>
        </div>
    </div>

    <div class="messages-container" id="messages-container">
        @if (Model != null && Model.Any())
        {
            @foreach (var msg in Model)
            {
                var isMine = msg.SenderId == User.FindFirstValue(ClaimTypes.NameIdentifier);
                <div class="message @(isMine ? "own" : "")" id="msg-@msg.Id">
                    <div class="message-avatar">
                        @((msg.SenderName ?? "U").FirstOrDefault().ToString().ToUpper())
                    </div>
                    <div class="message-content">
                        <div style="font-size:.8rem; color:var(--text-2); margin-bottom:.25rem; @(isMine ? "text-align: right;" : "")">
                            @msg.SenderName
                        </div>
                        <div class="message-bubble">
                            @if (msg.Type == Domain.Enums.MessageType.Voice && !string.IsNullOrEmpty(msg.AudioUrl))
                            {
                                <audio controls src="@msg.AudioUrl" preload="none" class="voice-player d-block"></audio>
                            }
                            else
                            {
                                @msg.Content
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">Start chatting...</div>
        }
    </div>

    <p id="typingIndicator" class="text-muted small mb-1 d-none" style="padding:0 1rem;"></p>

    <div class="input-container">
        <input type="text" id="messageInput" class="message-input" placeholder="Type message..." />
        <button id="send-btn" class="send-btn">Send</button>
        <button type="button" id="recordBtn" class="send-btn">🎤</button>
        <span id="recordingBadge" class="d-none">🔴 Recording...</span>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <input type="hidden" id="room-id" value="@ViewBag.RoomId" />

    <script>
        window.__notifHubReady = true;
        // ── Auth guard ──────────────────────────────────────────
        const jwtToken = TokenManager.getToken();
        if (!jwtToken || !TokenManager.isTokenValid()) {
            window.location.href = '/Auth/Login';
        }

        const userFromToken      = TokenManager.getUser();
        const roomId             = document.getElementById("room-id").value;
        const currentUserId      = userFromToken?.userId || '';
        const currentDisplayName = userFromToken?.displayName || 'Unknown';

        if (!currentUserId) window.location.href = '/Auth/Login';

        // ── Helpers ─────────────────────────────────────────────
        const receivedIds = new Set();

        function escHtml(s) {
            return String(s ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function appendMessage(msg) {
            const container = document.getElementById("messages-container");
            if (receivedIds.has(msg.id)) return;
            receivedIds.add(msg.id);

            const isMine = msg.senderId === currentUserId;
            const empty  = container.querySelector('.empty-state');
            if (empty) empty.remove();

            const div = document.createElement("div");
            div.className = isMine ? "message own" : "message";
            div.id = `msg-${msg.id}`;

            let bubbleContent = '';
            if (msg.type === 1 && msg.audioUrl) {
                bubbleContent = `<audio controls src="${escHtml(msg.audioUrl)}" preload="none" class="voice-player d-block"></audio>`;
            } else {
                bubbleContent = escHtml(msg.content);
            }

            div.innerHTML = `
                <div class="message-avatar">${(msg.senderName || 'U').charAt(0).toUpperCase()}</div>
                <div class="message-content">
                    <div style="font-size:.8rem;color:var(--text-2);margin-bottom:.25rem;${isMine ? 'text-align:right;' : ''}">
                        ${escHtml(msg.senderName)}
                    </div>
                    <div class="message-bubble">${bubbleContent}</div>
                </div>`;

            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        // ── SignalR ─────────────────────────────────────────────
        let connection;

        // ✅ FIX: تعريف واحد بس لـ startConnection + try/catch صح
        async function startConnection() {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/chathub", {
                    accessTokenFactory: () => TokenManager.getToken() || ''
                })
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveMessage", msg => appendMessage(msg));

            try {
                await connection.start();
                await connection.invoke("JoinRoom", roomId);
            } catch (err) {
                console.error("Connection failed:", err);
                return;
            }

            window.ChatConfig = {
                connection,
                currentUserId,
                currentDisplayName,
                mode: "room",
                roomId,
                targetUserId: null
            };
            window.__notifHubReady = true;
        }

        // ✅ FIX: الـ listeners برا startConnection عشان يتعملوا دايماً
        document.addEventListener("DOMContentLoaded", async () => {
            const container = document.getElementById("messages-container");
            container.scrollTop = container.scrollHeight;

            const sendBtn = document.getElementById("send-btn");
            const input   = document.getElementById("messageInput");

        function playNotifSound() {
       try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx  = new AudioCtx();
        const gain = ctx.createGain();
        gain.connect(ctx.destination);
        gain.gain.setValueAtTime(0, ctx.currentTime);
        gain.gain.linearRampToValueAtTime(0.35, ctx.currentTime + 0.01);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.55);
        [[523, 0], [659, 0.18]].forEach(([freq, delay]) => {
            const osc = ctx.createOscillator();
            osc.type = 'sine';
            osc.frequency.value = freq;
            osc.connect(gain);
            osc.start(ctx.currentTime + delay);
            osc.stop(ctx.currentTime + delay + 0.35);
        });
        setTimeout(() => ctx.close(), 800);
    } catch (_) {}
}

            // ✅ FIX: try/catch على invoke
        sendBtn.addEventListener("click", async () => {
        const text = input.value.trim();
        if (!text || !connection) return;
        try {
        await connection.invoke("SendRoomMessage", roomId, text);
        input.value = "";
        playNotifSound(); // ← ضيف ده
        } catch (err) {
        console.error("Send failed:", err);
        }
        });
            input.addEventListener("keydown", e => {
                if (e.key === "Enter" && !e.shiftKey) {
                    e.preventDefault();
                    sendBtn.click();
                }
            });

            await startConnection();
        });
    </script>

    <script src="~/js/chat-features.js"></script>
}
